{
  "name": "gestor-condominios-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "front",
    "back/*"
  ],
  "scripts": {
    "lint:front": "eslint 'front/**/*.{ts,tsx}' 'back/**/*.{ts,js,json}'",
    "format:check": "prettier --check 'front/**/*.{ts,tsx,js,json,css}' 'back/**/*.{ts,js,json}'",
    "format": "prettier --write 'front/**/*.{ts,tsx,js,json,css}' 'back/**/*.{ts,js,json}'",
    "db:init:auth": "yarn workspace auth-service db:init",
    "db:init:core": "yarn workspace core-service db:init",
    "db:init:delivery": "yarn workspace delivery-service db:init",
    "db:init:reservation": "yarn workspace reservation-service db:init",
    "db:init:visitor": "yarn workspace visitor-service db:init",
    "db:init:communication": "yarn workspace communication-service db:init",
    "db:init:file": "yarn workspace file-service db:init",
    "db:init": "yarn db:init:auth && yarn db:init:core && yarn db:init:delivery && yarn db:init:reservation && yarn db:init:visitor && yarn db:init:communication && yarn db:init:file"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "i18next-cli": "^1.51.7",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2"
  }
}
