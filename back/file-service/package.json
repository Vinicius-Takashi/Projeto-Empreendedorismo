{
  "name": "file-service",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "start": "tsx src/index.ts",
    "start:watch": "tsx watch src/index.ts",
    "db:generate": "yarn drizzle-kit generate",
    "db:migrate": "yarn drizzle-kit migrate",
    "db:populate": "tsx src/scripts/populate/index.ts",
    "db:init": "yarn db:generate && yarn db:migrate && yarn db:populate"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "axios": "^1.15.2",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.18.1",
    "minio": "^8.0.6",
    "multer": "^2.0.2",
    "pg": "^8.20.0",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.21",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
